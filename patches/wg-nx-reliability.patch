+err_t LwipRelay::flushPendingTcpToRemote(TcpConnection* conn, struct tcp_pcb* pcb) {
+    if (!conn || !pcb) return ERR_ARG;
+
+    bool wrote = false;
+    auto outputIfWritten = [&]() {
+        if (wrote) (void)tcp_output(pcb);
+    };
+    while (conn->pendingDataOffset < conn->pendingData.size()) {
+        u16_t available = tcp_sndbuf(pcb);
+        if (available == 0) {
+            outputIfWritten();
+            return ERR_MEM;
+        }
+
+        size_t remaining = conn->pendingData.size() - conn->pendingDataOffset;
+        u16_t chunk = static_cast<u16_t>(std::min<size_t>(remaining, available));
+        err_t err = tcp_write(pcb,
+                              conn->pendingData.data() + conn->pendingDataOffset,
+                              chunk, TCP_WRITE_FLAG_COPY);
+        if (err != ERR_OK) {
+            outputIfWritten();
+            return err;
+        }
+        conn->pendingDataOffset += chunk;
+        wrote = true;
+    }
+
+    if (conn->pendingDataOffset == conn->pendingData.size()) {
+        conn->pendingData.clear();
+        conn->pendingDataOffset = 0;
+    }
+
+    outputIfWritten();
+
+    if (conn->localEof && conn->pendingData.empty() && !conn->localWriteShutdown) {
+        err_t err = tcp_shutdown(pcb, 0, 1);
+        if (err != ERR_OK) return err;
+        conn->localWriteShutdown = true;
+    }
+
+    return ERR_OK;
